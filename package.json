{
  "name": "biglake-sistema",
  "productName": "BIG LAKE Gestão",
  "version": "0.9.1",
  "description": "Sistema de gestão da BIG LAKE Sorveteria",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "tipos": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "formatar": "prettier --write .",
    "teste": "vitest run",
    "teste:cobertura": "vitest run --coverage",
    "e2e": "electron-vite build && playwright test",
    "verificar": "npm run tipos && npm run lint && npm run teste && npm run e2e",
    "instalador": "electron-vite build && electron-builder --win --x64",
    "icone": "electron-vite build && node scripts/gerar-icone.cjs",
    "manual": "electron-vite build && playwright test -c playwright.manual.config.ts",
    "exemplo": "vitest run --config testes/exemplo/vitest.config.mts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@floating-ui/react": "0.27.20",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/baloo-2": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "5.105.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss-pxtorem": "6.1.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "author": "Lucas"
}
